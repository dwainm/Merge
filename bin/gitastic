#!/bin/sh
# The old name. Anything still typing `gitastic` gets `merge`, and the old
# environment variables are honoured.
[ -n "$GITASTIC_URL" ] && [ -z "$MERGE_URL" ] && export MERGE_URL="$GITASTIC_URL"
[ -n "$GITASTIC_AS" ] && [ -z "$MERGE_AS" ] && export MERGE_AS="$GITASTIC_AS"
exec "$(dirname "$(readlink -f "$0")")/merge" "$@"
