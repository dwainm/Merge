#!/bin/sh
# The merge command, runnable from any directory: it remembers where it was
# run from (the default repo and agent name) and runs the Mix task in the project.
set -e
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export MERGE_CWD="$PWD"
cd "$root"
case "$1" in
  serve) shift; exec mix merge.serve "$@" ;;
  # Builds the release and puts the service on it (see bin/deploy).
  deploy) shift; exec "$root/bin/deploy" "$@" ;;
  # Builds the release and puts the service on it (see bin/deploy).
  deploy) shift; exec "$root/bin/deploy" "$@" ;;
  # Quiet, so a compile message never lands in what an agent reads.
  *) MIX_QUIET=1 exec mix merge "$@" ;;
esac
