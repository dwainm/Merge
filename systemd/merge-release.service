# The Merge server as a systemd user service, running the built release that
# `merge deploy` makes (~/.merge/release), on a fixed port so the MCP URL
# stays the same. Install (the unit keeps the name `merge`):
#   ln -sfn /root/projects/merge/systemd/merge-release.service ~/.config/systemd/user/merge.service
#   systemctl --user daemon-reload && systemctl --user restart merge
# `merge.service` beside this file is the development server it replaced.
[Unit]
Description=Merge: the easy workflow for Elixir projects
After=network-online.target caddy-dev.service

[Service]
WorkingDirectory=%h
Environment=PORT=4747
Environment=MERGE_REPO=/root/projects/dayofplenty
Environment="MERGE_CHECK=MIX_ENV=test MIX_TEST_PARTITION=_merge_checks; export MIX_ENV MIX_TEST_PARTITION; mix deps.get && mix compile --warnings-as-errors && mix check"
Environment="MERGE_CHECK_IMAGE=docker build --quiet -t dop-merge-check ."
# Main is pushed this long after its tip was proven and has not moved (the user, 19 Nov 2026: 2 minutes, was 5).
Environment=MERGE_AUTO_PUSH_AFTER=2m
ExecStart=%h/.merge/release/bin/merge start
Restart=always
RestartSec=3
# A stop takes a second or two; anything slower is cut short.
TimeoutStopSec=15

[Install]
WantedBy=default.target
