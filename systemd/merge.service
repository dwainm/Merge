# The Merge server as a systemd user service, on a fixed port so the MCP URL
# stays the same. Install: systemctl --user enable --now /root/projects/merge/systemd/merge.service
[Unit]
Description=Merge: the easy workflow for Elixir projects
After=network-online.target caddy-dev.service

[Service]
WorkingDirectory=/root/projects/merge
ExecStart=/root/projects/merge/bin/merge serve --port 4747 --repo /root/projects/dayofplenty --check 'MIX_ENV=test MIX_TEST_PARTITION=_merge_checks; export MIX_ENV MIX_TEST_PARTITION; mix deps.get && mix compile --warnings-as-errors && mix check'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
