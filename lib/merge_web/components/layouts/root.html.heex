<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Merge" suffix=" · Merge" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="64x64" />
    <link rel="icon" type="image/svg+xml" href={~p"/images/logo.svg"} />
    <link rel="apple-touch-icon" href={~p"/images/logo-180.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    {Phoenix.HTML.raw("<style>" <> Merge.Highlight.stylesheet() <> "</style>")}
  </head>
  <body class="min-h-screen bg-(--bg) text-(--text)">
    {@inner_content}
  </body>
</html>
